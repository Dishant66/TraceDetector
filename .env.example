# TraceDetector — optional AI vision backend
#
# The app works fully WITHOUT any of these values:
#   • On-Device Scan  — real metadata / barcode / filename analysis in the browser
#   • Demo Analysis   — clearly-labelled sample report
#
# Set a key here to additionally unlock "AI Analysis".
# Copy this file to `.env.local` (git-ignored) and fill it in.
#
# IMPORTANT: these variables are deliberately NOT prefixed with VITE_, which
# means Vite will never inline them into the client bundle. They are read only
# by the server-side handlers in /api.

# Required to enable AI analysis
TRACEDETECTOR_AI_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI gateway, OpenRouter, Groq, a local LLM, ...)
# Default: https://api.openai.com/v1
TRACEDETECTOR_AI_BASE_URL=https://api.openai.com/v1

# Vision-capable model id. Default: gpt-4o-mini
TRACEDETECTOR_AI_MODEL=gpt-4o-mini
